---
import { ArrowUp } from '@lucide/astro';
import { portfolio } from '../../data/portfolio';
import { activeSocials, mailtoLink, navItems } from '../../utils/content';
import BrandIcon from '../ui/BrandIcon.astro';

const { personal } = portfolio;
const year = new Date().getFullYear();
const nameParts = personal.fullName.split(' ');
const lastName = nameParts.at(-1);
const firstNames = nameParts.slice(0, -1).join(' ');
---

<footer class="relative overflow-hidden border-t border-line pt-16 md:pt-24">
  <div class="container-page">
    <div class="grid gap-12 md:grid-cols-12">
      <div class="md:col-span-5">
        <p class="eyebrow mb-4">Get in touch</p>
        <a
          href={mailtoLink()}
          class="link-underline text-xl font-medium tracking-tight break-all md:text-2xl"
        >
          {personal.email}
        </a>
      </div>

      <nav aria-label="Footer" class="md:col-span-4">
        <p class="eyebrow mb-4">Index</p>
        <ul class="grid grid-cols-2 gap-x-6 gap-y-2 text-sm">
          {
            navItems.map((item) => (
              <li>
                <a href={item.href} class="link-underline text-ink-soft hover:text-ink">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="md:col-span-3 md:justify-self-end">
        {
          activeSocials.length > 0 && (
            <>
              <p class="eyebrow mb-4">Elsewhere</p>
              <ul class="flex flex-wrap gap-2">
                {activeSocials.map((social) => (
                  <li>
                    <a
                      href={social.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={social.label}
                      class="inline-flex size-10 items-center justify-center rounded-full border border-line-strong text-ink-soft transition-[color,background-color,translate] duration-300 ease-apple hover:-translate-y-0.5 hover:bg-ink hover:text-bg"
                    >
                      <BrandIcon platform={social.platform} size={17} />
                    </a>
                  </li>
                ))}
              </ul>
            </>
          )
        }
      </div>
    </div>

    <div class="mt-16 flex flex-col-reverse items-start justify-between gap-6 border-t border-line py-6 text-sm text-muted sm:flex-row sm:items-center">
      <p>
        © <span data-year>{year}</span>{' '}{personal.fullName}. All rights reserved.
      </p>
      <button
        type="button"
        data-back-to-top
        class="group inline-flex items-center gap-2 rounded-full border border-line-strong py-2 pr-2 pl-4 text-ink transition-colors duration-300 hover:bg-ink hover:text-bg"
      >
        Back to top
        <span class="inline-flex size-7 items-center justify-center rounded-full bg-subtle text-ink transition-transform duration-500 ease-spring group-hover:-translate-y-0.5">
          <ArrowUp size={14} aria-hidden="true" />
        </span>
      </button>
    </div>
  </div>

  <!-- Oversized wordmark -->
  <p
    class="footer-wordmark pointer-events-none container-page -mb-[0.2em] text-[clamp(3.5rem,15.5vw,15rem)] leading-[0.8] font-semibold tracking-[-0.06em] whitespace-nowrap select-none"
    aria-hidden="true"
  >
    <span class="text-[0.28em] tracking-[-0.03em] block mb-[0.3em] font-medium text-muted">{firstNames}</span>
    {lastName}<span class="accent-serif text-accent">.</span>
  </p>
</footer>

<style>
  .footer-wordmark {
    background: linear-gradient(180deg, var(--ink) 0%, color-mix(in oklab, var(--ink) 25%, transparent) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .footer-wordmark .text-muted {
    -webkit-text-fill-color: var(--muted);
  }
  .footer-wordmark .text-accent {
    -webkit-text-fill-color: var(--accent);
  }
</style>
