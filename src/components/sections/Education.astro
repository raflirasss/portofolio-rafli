---
import { GraduationCap, MapPin } from '@lucide/astro';
import { portfolio } from '../../data/portfolio';
import { isPlaceholder } from '../../utils/content';
import SectionHeader from '../ui/SectionHeader.astro';

const { education } = portfolio;
---

<section id="education" aria-labelledby="education-title" class="relative py-24 md:py-36">
  <div class="container-page">
    <SectionHeader id="education" />

    <ul class="border-t border-line">
      {
        education.map((item, index) => (
          <li class="group relative border-b border-line" data-reveal style={`--d:${index}`}>
            <div class="edu-hover pointer-events-none absolute inset-0 origin-bottom scale-y-0 bg-subtle transition-transform duration-700 ease-apple group-hover:scale-y-100" aria-hidden="true" />
            <div class="relative grid gap-6 py-10 md:grid-cols-12 md:gap-8 md:px-6 md:py-14">
              <div class="flex items-start gap-4 md:col-span-7">
                <span class="mt-1 inline-flex size-12 shrink-0 items-center justify-center rounded-2xl bg-ink text-bg transition-[rotate] duration-700 ease-spring group-hover:-rotate-8">
                  <GraduationCap size={22} stroke-width={1.75} aria-hidden="true" />
                </span>
                <div>
                  <h3 class:list={['text-[clamp(1.6rem,3.2vw,2.5rem)] leading-tight font-semibold tracking-[-0.035em]', isPlaceholder(item.institution) && 'text-muted italic']}>
                    {item.institution}
                  </h3>
                  <p class="mt-2 text-lg text-ink-soft">{item.degree}</p>
                </div>
              </div>

              <div class="md:col-span-5 md:text-right">
                <p class:list={['font-mono text-sm tracking-[0.04em]', isPlaceholder(item.period) ? 'text-muted italic' : 'text-ink']}>
                  {item.period}
                </p>
                {item.gpa && (
                  <p class="mt-3 inline-flex items-baseline gap-2 rounded-full border border-line-strong px-3 py-1 text-sm">
                    <span class="eyebrow">GPA</span>
                    <span class="font-medium">{item.gpa}</span>
                  </p>
                )}
                {item.location && (
                  <p class="mt-2 flex items-center gap-1.5 text-sm text-muted md:justify-end">
                    <MapPin size={14} aria-hidden="true" /> {item.location}
                  </p>
                )}
                {item.description && <p class="mt-4 text-pretty text-muted md:ml-auto md:max-w-sm">{item.description}</p>}
                {item.highlights && item.highlights.length > 0 && (
                  <ul class="mt-4 space-y-1 text-sm text-ink-soft">
                    {item.highlights.map((highlight) => <li>{highlight}</li>)}
                  </ul>
                )}
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
