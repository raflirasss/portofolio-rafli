---
import { ArrowRight, ArrowUpRight, MapPin } from '@lucide/astro';
import { portfolio } from '../../data/portfolio';
import { isPlaceholder, projectUrl } from '../../utils/content';
import SectionHeader from '../ui/SectionHeader.astro';
import Tag from '../ui/Tag.astro';

const { experience, projects } = portfolio;

// Projects linked from an experience entry, in the order listed there.
const linkedProjects = (slugs: string[] = []) =>
  slugs.flatMap((slug) => projects.find((project) => project.slug === slug) ?? []);
// "BKF Cafe Supplies — Social Media …" → "BKF Cafe Supplies"
const shortTitle = (title: string) => title.split(' — ')[0];
---

<section id="experience" aria-labelledby="experience-title" class="relative py-24 md:py-36">
  <div class="container-page">
    <SectionHeader id="experience" />

    <ol class="timeline relative">
      {
        experience.map((item, index) => (
          <li class="group relative grid gap-3 pb-12 pl-8 last:pb-0 md:grid-cols-12 md:gap-8 md:pl-0" data-reveal style={`--d:${index}`}>
            <div class="md:col-span-3 md:pt-1.5 md:pr-10 md:text-right">
              <p class:list={['font-mono text-xs tracking-[0.06em] uppercase', isPlaceholder(item.period) ? 'text-muted italic' : 'text-ink-soft']}>
                {item.period}
              </p>
              {item.type && <p class="mt-1 text-xs text-muted">{item.type}</p>}
            </div>

            <span
              class="absolute top-2 left-0 size-3 -translate-x-1/2 rounded-full border-2 border-bg bg-line-strong ring-1 ring-line-strong transition-[background-color,scale] duration-500 ease-spring group-hover:scale-125 group-hover:bg-accent md:left-[25%] md:-translate-x-1/2"
              aria-hidden="true"
            />

            <div class="card-surface rounded-3xl p-6 transition-[border-color,translate] duration-500 ease-apple group-hover:translate-x-1 group-hover:border-line-strong md:col-span-9 md:ml-6 md:p-8">
              <div class="flex flex-wrap items-start justify-between gap-x-6 gap-y-2">
                <div>
                  <h3 class="text-xl font-semibold tracking-tight md:text-2xl">{item.role}</h3>
                  <p class="mt-1 text-ink-soft">
                    {item.url ? (
                      <a href={item.url} target="_blank" rel="noopener noreferrer" class="link-underline inline-flex items-center gap-1">
                        {item.organization} <ArrowUpRight size={14} aria-hidden="true" />
                      </a>
                    ) : (
                      item.organization
                    )}
                  </p>
                </div>
                {item.location && (
                  <p class="inline-flex items-center gap-1.5 text-sm text-muted">
                    <MapPin size={14} aria-hidden="true" /> {item.location}
                  </p>
                )}
              </div>

              <p class="mt-4 max-w-2xl text-pretty text-muted">{item.description}</p>

              {item.highlights && item.highlights.length > 0 && (
                <ul class="mt-4 space-y-1.5 text-sm text-ink-soft">
                  {item.highlights.map((highlight) => (
                    <li class="flex gap-3">
                      <span class="mt-2 size-1 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                      {highlight}
                    </li>
                  ))}
                </ul>
              )}

              {item.tags && item.tags.length > 0 && (
                <ul class="mt-6 flex flex-wrap gap-1.5" aria-label="Tags">
                  {item.tags.map((tag) => <li><Tag tone="outline">{tag}</Tag></li>)}
                </ul>
              )}

              {linkedProjects(item.projects).length > 0 && (
                <div class="mt-6 border-t border-line pt-5">
                  <p class="eyebrow mb-3">Work from this role</p>
                  <ul class="flex flex-wrap gap-2">
                    {linkedProjects(item.projects).map((project) => (
                      <li>
                        <a
                          href={projectUrl(project)}
                          class="group/link inline-flex h-9 items-center gap-2 rounded-full border border-line-strong pr-3 pl-4 text-sm font-medium transition-colors hover:border-ink hover:bg-ink hover:text-bg"
                        >
                          {shortTitle(project.title)}
                          <ArrowRight size={14} class="transition-transform duration-500 ease-apple group-hover/link:translate-x-0.5" aria-hidden="true" />
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .timeline::before {
    content: '';
    position: absolute;
    top: 0.5rem;
    bottom: 0;
    left: 0;
    width: 1px;
    background: linear-gradient(to bottom, var(--line-strong), var(--line) 85%, transparent);
  }
  @media (min-width: 48rem) {
    .timeline::before {
      left: 25%;
    }
  }
</style>
