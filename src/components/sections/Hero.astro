---
import { ArrowDown, ArrowRight, Download } from '@lucide/astro';
import { portfolio } from '../../data/portfolio';
import { accent, cvAvailable } from '../../utils/content';
import Button from '../ui/Button.astro';

const { personal, hero, cv } = portfolio;

// Split the name into two balanced display lines; the last word gets the serif accent.
const words = personal.fullName.split(' ');
const splitAt = Math.ceil(words.length / 2);
const firstLine = words.slice(0, splitAt).join(' ');
const secondWords = words.slice(splitAt);
const lastWord = secondWords.pop();
const secondLine = secondWords.join(' ');
---

<section
  id="top"
  aria-label="Introduction"
  class="relative isolate flex min-h-svh flex-col overflow-hidden pt-28 pb-10 md:pt-32"
>
  <!-- Backdrop -->
  <div class="hero-backdrop grain pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>

  <div class="container-page relative flex flex-1 flex-col">
    <!-- Meta row -->
    <div class="fade-up flex flex-wrap items-center justify-between gap-3 border-b border-line pb-4" style="--d:0">
      <p class="eyebrow">
        <span class="text-ink">({hero.eyebrow})</span>
        <span class="mx-2 text-line-strong">/</span>
        {personal.role}
      </p>
      {
        personal.availability && (
          <p class="inline-flex items-center gap-2 rounded-full border border-line px-3 py-1 text-xs font-medium text-ink-soft">
            <span class="size-1.5 animate-[pulse-dot_2.4s_ease-out_infinite] rounded-full bg-emerald-500 text-emerald-500" />
            {personal.availability}
          </p>
        )
      }
    </div>

    <div class="relative flex flex-1 items-center py-14 lg:py-10">
      <div class="relative w-full">
        <p
          class="fade-up mb-6 max-w-xl text-[clamp(1.15rem,2.2vw,1.6rem)] leading-snug tracking-tight text-pretty text-ink-soft md:mb-8"
          style="--d:1"
          set:html={accent(hero.headline)}
        />

        <h1 class="display text-[clamp(2.9rem,11.5vw,5.5rem)] lg:text-[clamp(5.5rem,9.6vw,9.6rem)]">
          <span class="sr-only">{personal.fullName}</span>
          <span aria-hidden="true">
            <span class="line-mask"><span style="--d:2">{firstLine}</span></span>
            <span class="line-mask">
              <span style="--d:3">
                {secondLine}{' '}
                <span class="accent-serif pr-[0.06em] text-accent">{lastWord}</span>
              </span>
            </span>
          </span>
        </h1>
      </div>
    </div>

    <!-- Intro + actions -->
    <div class="grid gap-8 border-t border-line pt-6 md:grid-cols-12 md:items-end">
      <p class="fade-up max-w-md text-pretty text-muted md:col-span-6 md:text-[1.05rem] lg:col-span-5" style="--d:4">
        {hero.intro}
      </p>
      <div class="fade-up flex flex-wrap items-center gap-3 md:col-span-6 md:justify-end lg:col-span-7" style="--d:5">
        <Button href={hero.primaryCta.href} size="lg" class="w-full sm:w-auto">
          {hero.primaryCta.label}
          <ArrowRight size={17} class="transition-transform duration-500 ease-apple group-hover/btn:translate-x-1" aria-hidden="true" />
        </Button>
        {
          cvAvailable && (
            <Button href={cv.path} variant="secondary" size="lg" download={cv.downloadName} class="w-full sm:w-auto">
              <Download size={17} class="transition-transform duration-500 ease-spring group-hover/btn:translate-y-0.5" aria-hidden="true" />
              {hero.secondaryCta.label}
            </Button>
          )
        }
        <a
          href="#about"
          class="ml-1 hidden size-13 items-center justify-center rounded-full border border-line text-muted transition-colors hover:text-ink lg:inline-flex"
          aria-label="Scroll to About section"
        >
          <ArrowDown size={17} class="animate-bounce [animation-duration:2.4s]" aria-hidden="true" />
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Marquee of disciplines -->
<div class="marquee relative overflow-hidden border-y border-line bg-elevated py-5" aria-hidden="true">
  <div class="marquee-track flex w-max">
    {
      [0, 1].map(() => (
        <ul class="flex shrink-0 items-center">
          {[...hero.disciplines, ...hero.disciplines].map((discipline, index) => (
            <li class="flex items-center gap-8 pr-8 text-[clamp(1.4rem,3vw,2.25rem)] font-medium tracking-[-0.03em] whitespace-nowrap">
              <span class:list={[index % 2 === 1 && 'accent-serif text-muted']}>{discipline}</span>
              <span class="size-2 rotate-45 bg-accent" />
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>

<style>
  .hero-backdrop {
    background:
      radial-gradient(60% 50% at 85% 40%, color-mix(in oklab, var(--accent) 14%, transparent), transparent 70%),
      radial-gradient(40% 40% at 10% 90%, color-mix(in oklab, var(--warm) 9%, transparent), transparent 70%),
      linear-gradient(to right, var(--line) 1px, transparent 1px) 0 0 / calc(100% / var(--cols, 4)) 100%;
    mask-image: linear-gradient(to bottom, black 55%, transparent);
  }
  @media (min-width: 48rem) {
    .hero-backdrop {
      --cols: 8;
    }
  }
  @media (min-width: 64rem) {
    .hero-backdrop {
      --cols: 12;
    }
  }
  .marquee {
    mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
  }
  .marquee-track {
    animation: marquee 45s linear infinite;
  }
  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
