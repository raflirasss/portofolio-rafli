---
import { Moon, Sun } from '@lucide/astro';

interface Props {
  class?: string;
}
---

<button
  type="button"
  data-theme-toggle
  class:list={[
    'group relative inline-flex size-10 items-center justify-center overflow-hidden rounded-full text-ink transition-[background-color,scale] duration-300 ease-apple hover:bg-subtle active:scale-90',
    Astro.props.class,
  ]}
  aria-label="Toggle dark mode"
  aria-pressed="false"
>
  <Sun
    size={18}
    stroke-width={1.75}
    class="absolute transition-[rotate,scale,opacity] duration-700 ease-spring dark:scale-50 dark:-rotate-90 dark:opacity-0"
    aria-hidden="true"
  />
  <Moon
    size={18}
    stroke-width={1.75}
    class="absolute scale-50 rotate-90 opacity-0 transition-[rotate,scale,opacity] duration-700 ease-spring dark:scale-100 dark:rotate-0 dark:opacity-100"
    aria-hidden="true"
  />
</button>
