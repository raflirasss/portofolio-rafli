---
import { ArrowUpRight, Award, FileText } from '@lucide/astro';
import type { Certificate } from '../../types/portfolio';
import { isPlaceholder } from '../../utils/content';
import SmartImage from '../ui/SmartImage.astro';
import Tag from '../ui/Tag.astro';

interface Props {
  certificate: Certificate;
  index: number;
  /** Horizontal layout with a large preview — used when there's a single certificate. */
  wide?: boolean;
}

const { certificate, index, wide = false } = Astro.props;
const placeholder = isPlaceholder(certificate.title);
// The preview opens the original PDF when there is one, otherwise the credential page.
const previewHref = certificate.file ?? certificate.credentialUrl;
---

<article
  class:list={[
    'card-surface group relative flex flex-col overflow-hidden rounded-[1.75rem] transition-[translate,border-color,box-shadow] duration-700 ease-apple hover:-translate-y-1 hover:border-line-strong hover:shadow-[0_30px_60px_-36px_rgb(var(--shadow-color)/0.5)]',
    wide && 'lg:flex-row lg:items-stretch',
  ]}
  data-reveal
  style={`--d:${index % 3}`}
>
  <div class:list={['m-2 shrink-0', wide && 'lg:w-[56%]']}>
    {
      certificate.image ? (
        <a
          href={previewHref}
          target="_blank"
          rel="noopener noreferrer"
          class="relative block overflow-hidden rounded-[1.35rem] bg-subtle"
          aria-label={`Open ${certificate.title} certificate`}
        >
          <SmartImage
            src={certificate.image.src}
            alt={certificate.image.alt}
            position={certificate.image.position}
            class="aspect-[1.414] size-full object-cover transition-transform duration-[1.2s] ease-apple group-hover:scale-[1.03]"
            sizes={wide ? '(min-width: 1024px) 45vw, 100vw' : '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw'}
            widths={[480, 800, 1200]}
          />
          <span class="absolute right-3 bottom-3 inline-flex items-center gap-1.5 rounded-full bg-ink/85 px-3 py-1.5 text-xs font-medium text-bg opacity-0 backdrop-blur transition-[opacity,translate] duration-500 ease-apple group-hover:translate-y-0 group-hover:opacity-100 translate-y-1">
            {certificate.file ? 'Open PDF' : 'View'} <ArrowUpRight size={13} aria-hidden="true" />
          </span>
        </a>
      ) : (
        <div class="cert-art relative flex aspect-[4/3] items-center justify-center overflow-hidden rounded-[1.35rem] bg-subtle" aria-hidden="true">
          <span class="absolute inset-6 rounded-xl border border-dashed border-line-strong" />
          <Award size={44} stroke-width={1.25} class="text-muted transition-[rotate,scale,color] duration-700 ease-spring group-hover:scale-110 group-hover:-rotate-12 group-hover:text-accent" />
        </div>
      )
    }
  </div>

  <div class:list={['flex flex-1 flex-col p-6 pt-4', wide && 'lg:justify-center lg:p-10']}>
    <p class:list={['eyebrow mb-2', isPlaceholder(certificate.issuer) && 'italic']}>
      {certificate.issuer}{certificate.kind && <span> · {certificate.kind}</span>}
    </p>
    <h3
      class:list={[
        'leading-snug font-semibold tracking-tight text-balance',
        wide ? 'text-[clamp(1.4rem,2.4vw,2rem)] leading-tight' : 'text-lg',
        placeholder && 'text-muted italic',
      ]}
    >
      {certificate.title}
    </h3>

    {certificate.description && <p class="mt-3 text-sm text-pretty text-muted md:text-base">{certificate.description}</p>}

    <dl class="mt-5 grid grid-cols-2 gap-x-6 gap-y-3 text-sm">
      <div>
        <dt class="eyebrow mb-0.5">Issued</dt>
        <dd class="font-medium">{certificate.date}</dd>
      </div>
      {
        certificate.validUntil && (
          <div>
            <dt class="eyebrow mb-0.5">Valid until</dt>
            <dd class="font-medium">{certificate.validUntil}</dd>
          </div>
        )
      }
      {
        certificate.credentialId && (
          <div class="col-span-2">
            <dt class="eyebrow mb-0.5">Credential ID</dt>
            <dd class="font-mono font-medium tracking-wide">{certificate.credentialId}</dd>
          </div>
        )
      }
    </dl>

    {
      certificate.tags && certificate.tags.length > 0 && (
        <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="Tags">
          {certificate.tags.map((tag) => <li><Tag>{tag}</Tag></li>)}
        </ul>
      )
    }

    {
      (certificate.credentialUrl || certificate.file) && (
        <div class="mt-auto flex flex-wrap gap-2 pt-6">
          {certificate.credentialUrl && (
            <a
              href={certificate.credentialUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex h-10 items-center gap-1.5 rounded-full bg-ink px-4 text-sm font-medium text-bg transition-[scale] active:scale-95"
            >
              Verify credential <ArrowUpRight size={14} aria-hidden="true" />
            </a>
          )}
          {certificate.file && (
            <a
              href={certificate.file}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex h-10 items-center gap-1.5 rounded-full border border-line-strong px-4 text-sm font-medium transition-colors hover:bg-subtle"
            >
              <FileText size={14} aria-hidden="true" /> View PDF
            </a>
          )}
        </div>
      )
    }
  </div>
</article>

<style>
  .cert-art {
    background:
      radial-gradient(70% 60% at 50% 40%, color-mix(in oklab, var(--accent) 10%, transparent), transparent),
      repeating-linear-gradient(-45deg, transparent 0 14px, var(--line) 14px 15px),
      var(--bg-subtle);
  }
</style>
