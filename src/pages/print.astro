---
/**
 * Print / PDF version of the portfolio (A4).
 *
 * Built from the same content as the website (src/data/portfolio.ts), so the PDF
 * never drifts from the site. Export it with `npm run pdf`, or open /print/ in a
 * browser and use "Save as PDF".
 */
import '@fontsource-variable/inter-tight';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';

import { portfolio } from '../data/portfolio';
import type { ImageAsset, Project } from '../types/portfolio';
import ProjectCover from '../components/ui/ProjectCover.astro';
import SmartImage from '../components/ui/SmartImage.astro';
import {
  accent,
  activeSocials,
  formatPhone,
  mailtoLink,
  plain,
  projectUrl,
  absoluteUrl,
  whatsappLink,
} from '../utils/content';

const { personal, hero, about, skills, projects, experience, education, milestones, certificates, seo } =
  portfolio;

const siteHost = seo.siteUrl.replace(/^https?:\/\//, '');
const displayUrl = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/[/#].*$/, '');
const pad = (value: number) => String(value).padStart(2, '0');

// Name on the cover: last word in the serif accent.
const words = personal.fullName.split(' ');
const lastWord = words.pop();

const contacts = [
  { label: 'Email', value: personal.email, href: mailtoLink() },
  { label: 'WhatsApp', value: formatPhone(), href: whatsappLink() },
  { label: 'Website', value: siteHost, href: seo.siteUrl },
  ...activeSocials.map((social) => ({ label: social.label, value: displayUrl(social.url), href: social.url })),
];

const facts = [
  ...about.facts.filter((fact) => fact.label !== 'Email'),
  ...(personal.languages?.length ? [{ label: 'Languages', value: personal.languages.join(', ') }] : []),
];

// Gallery images other than the cover (the cover is already shown large).
const extraImages = (project: Project): (ImageAsset & { caption?: string })[] =>
  (project.gallery ?? []).filter((image) => image.src !== project.cover?.src);

const projectFacts = (project: Project) =>
  [
    { label: 'Category', value: project.category },
    project.year && { label: 'Year', value: project.year },
    project.company && { label: 'Company', value: project.company },
    project.status && { label: 'Status', value: project.status },
    project.role && { label: 'Role', value: project.role },
  ].filter((fact): fact is { label: string; value: string } => Boolean(fact));

const footerText = `${personal.fullName} — Portfolio`.replace(/"/g, '');
const pageCss = `
  @page {
    size: A4;
    margin: 16mm 15mm 18mm;
    @bottom-left { content: "${footerText}"; font: 7pt 'JetBrains Mono Variable', monospace; color: #5f5f67; }
    @bottom-right { content: counter(page) " / " counter(pages); font: 7pt 'JetBrains Mono Variable', monospace; color: #5f5f67; }
  }
  @page cover { margin: 0; @bottom-left { content: none; } @bottom-right { content: none; } }
`;
---

<!doctype html>
<html lang={seo.lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{personal.fullName} — Portfolio</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style is:inline set:html={pageCss}></style>
  </head>
  <body class="print-doc">
    <!-- ─────────────────────────────── Cover ─────────────────────────────── -->
    <section class="cover relative flex flex-col overflow-hidden bg-bg px-[16mm] pt-[16mm] pb-[14mm]">
      <div class="cover-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>

      <header class="relative flex items-center justify-between border-b border-line pb-[5mm]">
        <div class="flex items-center gap-[3mm]">
          <span class="inline-flex size-[11mm] flex-col items-center justify-center rounded-[2.5mm] bg-ink font-mono text-[6.5pt] leading-[1.05] font-bold tracking-[0.06em] text-bg">
            <span>{personal.monogram.slice(0, 2)}</span><span>{personal.monogram.slice(2, 4)}</span>
          </span>
          <span class="eyebrow text-ink">({hero.eyebrow})</span>
        </div>
        <span class="eyebrow">{personal.role}</span>
      </header>

      <div class="relative mt-[16mm] grid grid-cols-12 gap-[8mm]">
        <div class="col-span-7">
          <p class="mb-[8mm] text-[13pt] leading-snug tracking-tight text-ink-soft" set:html={accent(hero.headline)} />
          <h1 class="display text-[44pt] leading-[0.95]">
            {words.join(' ')}{' '}<span class="accent-serif text-accent">{lastWord}</span>
          </h1>
          <p class="mt-[8mm] max-w-[95mm] text-[10pt] leading-relaxed text-muted">{hero.intro}</p>
        </div>
        {
          personal.photo && (
            <figure class="col-span-5 overflow-hidden rounded-[5mm] bg-subtle">
              <SmartImage
                src={personal.photo.src}
                alt={personal.photo.alt}
                position={personal.photo.position}
                widths={[900, 1400]}
                sizes="900px"
                priority
                class="aspect-[4/5] size-full object-cover"
              />
            </figure>
          )
        }
      </div>

      <div class="relative mt-auto grid grid-cols-12 gap-[8mm] border-t border-line pt-[6mm]">
        <div class="col-span-7">
          <p class="eyebrow mb-[3mm]">Disciplines</p>
          <p class="text-[9.5pt] leading-relaxed text-ink-soft">{hero.disciplines.join(' · ')}</p>
        </div>
        <dl class="col-span-5 space-y-[1.6mm] text-[9pt]">
          {
            contacts.map((contact) => (
              <div class="flex justify-between gap-[4mm]">
                <dt class="eyebrow">{contact.label}</dt>
                <dd>
                  <a href={contact.href} class="font-medium text-ink">
                    {contact.value}
                  </a>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- ─────────────────────────── About & skills ─────────────────────────── -->
    <section class="doc-section">
      <p class="section-eyebrow"><span class="text-accent">(01)</span> About</p>
      <p class="mb-[6mm] text-[16pt] leading-[1.2] font-medium tracking-[-0.02em]" set:html={accent(about.statement)} />
      <div class="grid grid-cols-2 gap-[7mm] text-[9.5pt] leading-relaxed text-ink-soft">
        {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <dl class="mt-[6mm] grid grid-cols-2 border-t border-line text-[8.5pt]">
        {
          facts.map((fact) => (
            <div class="flex justify-between gap-[4mm] border-b border-line py-[2mm] odd:pr-[4mm] even:pl-[4mm]">
              <dt class="eyebrow">{fact.label}</dt>
              <dd class="text-right font-medium">{fact.value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="doc-section mt-[11mm]">
      <p class="section-eyebrow"><span class="text-accent">(02)</span> Skills</p>
      <div class="grid grid-cols-2 gap-[4mm]">
        {
          skills.map((category, index) => (
            <div class:list={['avoid rounded-[3mm] border border-line p-[4.5mm]', index === skills.length - 1 && skills.length % 2 === 1 && 'col-span-2']}>
              <h3 class="text-[10.5pt] font-semibold tracking-tight">{category.title}</h3>
              {category.description && <p class="mt-[0.8mm] text-[8pt] text-muted">{category.description}</p>}
              <ul class="mt-[3mm] flex flex-wrap gap-[1.5mm]">
                {category.skills.map((skill) => (
                  <li class="rounded-full border border-line-strong px-[2.4mm] py-[0.8mm] text-[7.5pt] text-ink-soft">{skill}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <!-- ───────────────────── Experience, education, milestones ───────────────────── -->
    <section class="doc-section page-break">
      <p class="section-eyebrow"><span class="text-accent">(03)</span> Experience</p>
      <ol class="space-y-[5mm]">
        {
          experience.map((item) => {
            const linked = (item.projects ?? []).flatMap((slug) => projects.find((project) => project.slug === slug) ?? []);
            return (
              <li class="avoid grid grid-cols-12 gap-[5mm] border-t border-line pt-[4mm]">
                <div class="col-span-3">
                  <p class="font-mono text-[8pt] tracking-[0.04em] text-ink-soft uppercase">{item.period}</p>
                  {item.location && <p class="mt-[1mm] text-[8pt] text-muted">{item.location}</p>}
                  {item.type && <p class="mt-[1mm] text-[8pt] text-muted">{item.type}</p>}
                </div>
                <div class="col-span-9">
                  <h3 class="text-[12pt] font-semibold tracking-tight">{item.role}</h3>
                  <p class="text-[9.5pt] text-ink-soft">{item.organization}</p>
                  <p class="mt-[2mm] text-[9pt] text-muted">{item.description}</p>
                  {item.highlights && item.highlights.length > 0 && (
                    <ul class="mt-[2.5mm] space-y-[1.2mm] text-[8.8pt] leading-snug text-ink-soft">
                      {item.highlights.map((highlight) => (
                        <li class="flex gap-[2.5mm]">
                          <span class="mt-[1.8mm] size-[1.2mm] shrink-0 rounded-full bg-accent" />
                          {highlight}
                        </li>
                      ))}
                    </ul>
                  )}
                  {linked.length > 0 && (
                    <p class="mt-[3mm] text-[8.5pt] text-muted">
                      <span class="eyebrow mr-[2mm]">Work from this role</span>
                      {linked.map((project) => plain(project.title).split(' — ')[0]).join(', ')} — see Projects
                    </p>
                  )}
                </div>
              </li>
            );
          })
        }
      </ol>
    </section>

    <section class="doc-section mt-[8mm]">
      <p class="section-eyebrow"><span class="text-accent">(04)</span> Education</p>
      {
        education.map((item) => (
          <div class="avoid grid grid-cols-12 gap-[5mm] border-t border-line pt-[4mm]">
            <div class="col-span-3">
              <p class="font-mono text-[8pt] tracking-[0.04em] text-ink-soft uppercase">{item.period}</p>
              {item.location && <p class="mt-[1mm] text-[8pt] text-muted">{item.location}</p>}
            </div>
            <div class="col-span-9">
              <h3 class="text-[12pt] font-semibold tracking-tight">{item.institution}</h3>
              <p class="text-[9.5pt] text-ink-soft">
                {item.degree}
                {item.gpa && <span class="text-muted"> · GPA {item.gpa}</span>}
              </p>
              {item.description && <p class="mt-[2mm] text-[9pt] text-muted">{item.description}</p>}
            </div>
          </div>
        ))
      }
    </section>

    {
      milestones.length > 0 && (
        <section class="doc-section avoid mt-[8mm]">
          <p class="section-eyebrow">
            <span class="text-accent">(05)</span> Achievements &amp; Milestones
          </p>
          {milestones.map((milestone) => (
            <div class="avoid grid grid-cols-12 items-center gap-[6mm] border-t border-line pt-[4mm]">
              <figure class="col-span-3 overflow-hidden rounded-[3mm] bg-subtle">
                <SmartImage
                  src={milestone.image.src}
                  alt={milestone.image.alt}
                  position={milestone.image.position}
                  widths={[700, 1000]}
                  sizes="700px"
                  priority
                  class="aspect-[4/5] size-full object-cover"
                />
              </figure>
              <div class="col-span-9">
                <p class="eyebrow mb-[1.5mm]">
                  {milestone.organization} · {milestone.date}
                </p>
                <h3 class="text-[14pt] leading-tight font-semibold tracking-tight">{milestone.title}</h3>
                {milestone.description && <p class="mt-[2.5mm] text-[9pt] leading-relaxed text-ink-soft">{milestone.description}</p>}
                {milestone.facts && (
                  <dl class="mt-[4mm] grid grid-cols-2 gap-x-[5mm] gap-y-[2.5mm] text-[8.5pt]">
                    {milestone.facts.map((fact) => (
                      <div>
                        <dt class="eyebrow">{fact.label}</dt>
                        <dd class="font-medium">{fact.value}</dd>
                      </div>
                    ))}
                  </dl>
                )}
                {milestone.caption && <p class="mt-[4mm] text-[8pt] text-muted italic">{milestone.caption}</p>}
              </div>
            </div>
          ))}
        </section>
      )
    }

    <!-- ─────────────────────────────── Projects ─────────────────────────────── -->
    {
      projects.map((project, index) => (
        <section class="doc-section page-break">
          <p class="section-eyebrow">
            <span class="text-accent">(06)</span> Projects · {pad(index + 1)} / {pad(projects.length)}
          </p>
          <h2 class="text-[22pt] leading-[1.05] font-semibold tracking-[-0.03em]">{project.title}</h2>
          <p class="mt-[2.5mm] text-[10pt] leading-relaxed text-ink-soft">{project.description ?? project.summary}</p>

          <div class="mt-[5mm] overflow-hidden rounded-[3.5mm] border border-line">
            <ProjectCover project={project} index={index} variant="hero" priority class="aspect-[2.1] w-full" />
          </div>

          <dl class="mt-[4mm] flex flex-wrap gap-x-[8mm] gap-y-[2mm] text-[8.5pt]">
            {projectFacts(project).map((fact) => (
              <div>
                <dt class="eyebrow">{fact.label}</dt>
                <dd class="font-medium">{fact.value}</dd>
              </div>
            ))}
            {project.tech.length > 0 && (
              <div>
                <dt class="eyebrow">Technology</dt>
                <dd class="font-medium">{project.tech.join(', ')}</dd>
              </div>
            )}
          </dl>

          {project.details && project.details.length > 0 && (
            <div class="mt-[5mm] grid grid-cols-2 gap-x-[7mm] gap-y-[4mm] border-t border-line pt-[4mm]">
              {project.details.map((block) => (
                <div class="avoid">
                  <h3 class="mb-[1.5mm] text-[9.5pt] font-semibold">{block.heading}</h3>
                  {Array.isArray(block.body) ? (
                    <ul class="space-y-[1mm] text-[8.5pt] leading-snug text-ink-soft">
                      {block.body.map((item) => (
                        <li class="flex gap-[2mm]">
                          <span class="mt-[1.6mm] size-[1.1mm] shrink-0 rounded-full bg-accent" />
                          {item}
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <p class="text-[8.5pt] leading-snug text-ink-soft">{block.body}</p>
                  )}
                </div>
              ))}
            </div>
          )}

          {extraImages(project).length > 0 && (
            <div class="avoid mt-[5mm]">
            <p class="eyebrow mb-[2.5mm]">More from this project</p>
            <div class:list={['grid gap-[4mm]', extraImages(project).length > 1 ? 'grid-cols-2' : 'grid-cols-1']}>
              {extraImages(project).map((image) => (
                <figure>
                  <div class="overflow-hidden rounded-[3mm] border border-line">
                    <SmartImage src={image.src} alt={image.alt} widths={[1000, 1600]} sizes="1000px" priority class="h-auto w-full" />
                  </div>
                  {image.caption && <figcaption class="mt-[1.5mm] text-[7.5pt] text-muted">{image.caption}</figcaption>}
                </figure>
              ))}
            </div>
            </div>
          )}

          <p class="avoid mt-[5mm] flex flex-wrap gap-x-[6mm] gap-y-[1.5mm] border-t border-line pt-[3mm] text-[8.5pt]">
            {project.links?.live && (
              <a href={project.links.live} class="font-medium text-accent">
                Live: {displayUrl(project.links.live)}
              </a>
            )}
            {project.links?.more?.map((link) => (
              <a href={link.url} class="font-medium text-accent">
                {link.label}
              </a>
            ))}
            <a href={absoluteUrl(projectUrl(project))} class="text-muted">
              Case study: {siteHost}
              {projectUrl(project).replace(/\/$/, '')}
            </a>
          </p>
        </section>
      ))
    }

    <!-- ───────────────────────────── Certificates ───────────────────────────── -->
    {
      certificates.length > 0 && (
        <section class="doc-section page-break">
          <p class="section-eyebrow">
            <span class="text-accent">(07)</span> Certificates
          </p>
          <ol class="space-y-[4mm]">
            {certificates.map((certificate) => (
              <li class="avoid grid grid-cols-12 gap-[6mm] border-t border-line pt-[4mm]">
                {certificate.image && (
                  <figure class="col-span-4 overflow-hidden rounded-[2.5mm] border border-line">
                    <SmartImage src={certificate.image.src} alt={certificate.image.alt} widths={[900, 1300]} sizes="900px" priority class="aspect-[1.414] w-full object-cover" />
                  </figure>
                )}
                <div class:list={[certificate.image ? 'col-span-8' : 'col-span-12']}>
                  <p class="eyebrow mb-[1.5mm]">
                    {certificate.issuer}
                    {certificate.kind && <span> · {certificate.kind}</span>}
                  </p>
                  <h3 class="text-[12pt] leading-tight font-semibold tracking-tight">{certificate.title}</h3>
                  {certificate.description && <p class="mt-[2mm] text-[8.5pt] leading-snug text-ink-soft">{certificate.description}</p>}
                  <dl class="mt-[3mm] grid grid-cols-2 gap-x-[5mm] gap-y-[2mm] text-[8.5pt]">
                    <div>
                      <dt class="eyebrow">Issued</dt>
                      <dd class="font-medium">{certificate.date}</dd>
                    </div>
                    {certificate.validUntil && (
                      <div>
                        <dt class="eyebrow">Valid until</dt>
                        <dd class="font-medium">{certificate.validUntil}</dd>
                      </div>
                    )}
                    {certificate.credentialId && (
                      <div class="col-span-2">
                        <dt class="eyebrow">Credential ID</dt>
                        <dd class="font-mono font-medium">{certificate.credentialId}</dd>
                      </div>
                    )}
                  </dl>
                  {certificate.credentialUrl && (
                    <p class="mt-[2.5mm] text-[8.5pt]">
                      <a href={certificate.credentialUrl} class="font-medium text-accent">
                        Verify credential ↗
                      </a>
                    </p>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    <!-- ─────────────────────────────── Contact ─────────────────────────────── -->
    <section class="doc-section avoid mt-[8mm] rounded-[4mm] bg-ink p-[7mm] text-bg">
      <p class="font-mono text-[7pt] tracking-[0.08em] uppercase opacity-70">Contact</p>
      <p class="mt-[2mm] text-[20pt] leading-tight font-semibold tracking-[-0.02em]" set:html={accent(portfolio.sections.contact.title)} />
      <dl class="mt-[5mm] grid grid-cols-2 gap-x-[8mm] gap-y-[2mm] text-[9pt]">
        {
          contacts.map((contact) => (
            <div class="flex justify-between gap-[4mm] border-b border-white/15 py-[1.5mm]">
              <dt class="font-mono text-[7pt] tracking-[0.08em] uppercase opacity-70">{contact.label}</dt>
              <dd>
                <a href={contact.href} class="font-medium">
                  {contact.value}
                </a>
              </dd>
            </div>
          ))
        }
      </dl>
    </section>
  </body>
</html>

<style is:global>
  html:has(.print-doc) {
    background: white;
  }
  .print-doc {
    background: white;
    color: var(--ink);
    font-size: 9.5pt;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  .print-doc a {
    text-decoration: none;
  }
  .cover {
    page: cover;
    width: 210mm;
    height: 296.6mm;
    break-after: page;
  }
  .cover-grid {
    background:
      radial-gradient(60% 45% at 90% 15%, color-mix(in oklab, var(--accent) 12%, transparent), transparent 70%),
      linear-gradient(to right, var(--line) 1px, transparent 1px) 0 0 / calc(100% / 6) 100%;
    mask-image: linear-gradient(to bottom, black 40%, transparent 85%);
  }
  .page-break {
    break-before: page;
  }
  .avoid {
    break-inside: avoid;
  }
  .section-eyebrow {
    display: flex;
    gap: 2mm;
    margin-bottom: 5mm;
    font-family: var(--font-mono);
    font-size: 7.5pt;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .print-doc .eyebrow {
    font-size: 6.5pt;
  }

  /* On screen: show the document like a stack of A4 sheets. */
  @media screen {
    html:has(.print-doc) {
      background: #d9d7d2;
    }
    .print-doc {
      width: 210mm;
      margin: 10mm auto;
      padding: 0 15mm 16mm;
      box-shadow: 0 10px 40px rgb(0 0 0 / 0.15);
    }
    .print-doc .cover {
      margin: 0 -15mm 16mm;
    }
  }
</style>
