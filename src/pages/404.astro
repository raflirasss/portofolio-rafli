---
import { ArrowLeft } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout title="Page not found">
  <section class="container-page flex min-h-[80svh] flex-col items-start justify-center pt-28">
    <p class="eyebrow fade-up mb-6">Error 404</p>
    <h1 class="display text-[clamp(3rem,12vw,10rem)]">
      <span class="line-mask"><span style="--d:1">Lost in</span></span>
      <span class="line-mask"><span style="--d:2" class="accent-serif text-accent">the orbit.</span></span>
    </h1>
    <p class="fade-up mt-8 max-w-md text-muted" style="--d:3">
      The page you are looking for doesn't exist or has moved.
    </p>
    <div class="fade-up mt-10" style="--d:4">
      <Button href="/">
        <ArrowLeft size={16} aria-hidden="true" /> Back to home
      </Button>
    </div>
  </section>
</BaseLayout>
